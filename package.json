{
  "name": "pine-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pine AI — custom AI phone agents for home-service businesses",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "tsx server/main.ts",
    "worker": "tsx server/worker.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev:web": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx server/scripts/seed-demo.ts",
    "dev:all": "npm run build && npm run dev"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "embedded-postgres": "^18.7.0-beta.19",
    "lucide-react": "^1.76.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
