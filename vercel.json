{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/lead", "destination": "https://pine.rasen.ai/api/lead" },
    { "source": "/api/join-lead", "destination": "https://pine.rasen.ai/api/lead" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" }
  ]
}
