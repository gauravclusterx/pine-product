{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/lead",
      "destination": "https://pine.rasen.ai/api/lead"
    },
    {
      "source": "/api/join-lead",
      "destination": "https://pine.rasen.ai/api/lead"
    },
    {
      "source": "/api/:path*",
      "destination": "https://pine.117-252-16-122.sslip.io/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://pine.117-252-16-122.sslip.io/healthz"
    },
    {
      "source": "/login",
      "destination": "/app"
    },
    {
      "source": "/app",
      "destination": "/app"
    },
    {
      "source": "/app/:path*",
      "destination": "/app"
    },
    {
      "source": "/admin",
      "destination": "/app"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app"
    }
  ]
}
