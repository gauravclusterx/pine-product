# ── required ──────────────────────────────────────────────────────────────────
# 64 hex chars. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts stored credentials. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=
# At least 32 chars. Signs session cookies; changing it signs everyone out.
SESSION_SECRET=

# ── database ──────────────────────────────────────────────────────────────────
# Empty in development = embedded PostgreSQL in ./.pgdata. Required in production.
DATABASE_URL=

# ── server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public https origin. Rasen calls back into it (webhook + agent tools); without it, calls are
# synced by polling and agents cannot use the Integration Hub tools.
PUBLIC_BASE_URL=
# Run background jobs in the API process (simple setups). At scale: false, and run `npm run worker`.
INLINE_WORKER=true
WORKER_CONCURRENCY=8
LOG_LEVEL=info

# First platform admin (created on boot if missing).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── voice ─────────────────────────────────────────────────────────────────────
RASEN_API_BASE=https://api.rasen.ai/v1
# Fallback webhook signing secret (each client's own secret is tried first).
RASEN_WEBHOOK_SECRET=

# ── optional ──────────────────────────────────────────────────────────────────
# Enables "Translate to English" on call transcripts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Web app build: where "Talk to us" on the landing page goes (mailto: or a booking link).
VITE_CONTACT_URL=

# ── sign-in (Google only) ─────────────────────────────────────────────────────
# OAuth client from Google Cloud. Redirect URI: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Staff domains: a verified Google email on these signs in as platform staff (admin panel).
GOOGLE_ALLOWED_DOMAINS=clusterx.ai,rasen.ai
# Extra public origins the app is served from, comma separated (PUBLIC_BASE_URL is always allowed).
APP_ORIGINS=

# ── landing page ──────────────────────────────────────────────────────────────
# The landing lead form is forwarded here (the pine.rasen.ai worker stores and emails leads).
LANDING_LEAD_URL=https://pine.rasen.ai/api/lead
# Platform admins (comma separated). They get the admin panel; everyone else is a customer.
PLATFORM_ADMIN_EMAILS=
# Online payments for plans and credit top-ups (optional; without them admins activate by hand).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
