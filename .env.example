# ── required ──────────────────────────────────────────────────────────────────
# 64 hex chars. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts stored credentials. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=
# At least 32 chars. Signs session cookies; changing it signs everyone out.
SESSION_SECRET=

# ── database ──────────────────────────────────────────────────────────────────
# Empty in development = embedded PostgreSQL in ./.pgdata. Required in production.
DATABASE_URL=

# ── server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public https origin. Rasen calls back into it (webhook + agent tools); without it, calls are
# synced by polling and agents cannot use the Integration Hub tools.
PUBLIC_BASE_URL=
# Run background jobs in the API process (simple setups). At scale: false, and run `npm run worker`.
INLINE_WORKER=true
WORKER_CONCURRENCY=8
LOG_LEVEL=info

# First platform admin (created on boot if missing).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── voice ─────────────────────────────────────────────────────────────────────
RASEN_API_BASE=https://api.rasen.ai/v1
# Fallback webhook signing secret (each client's own secret is tried first).
RASEN_WEBHOOK_SECRET=

# ── optional ──────────────────────────────────────────────────────────────────
# Enables "Translate to English" on call transcripts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Web app build: where "Talk to us" on the landing page goes (mailto: or a booking link).
VITE_CONTACT_URL=
